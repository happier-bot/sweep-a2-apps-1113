{
  "schemaVersion": 1,
  "apps": [
    {
      "itemId": "sweep-a2-148-admin",
      "app": {
        "schemaVersion": 1,
        "title": "SWEEP A2 148 Pgadmin",
        "description": "Owned first admin QA fixture",
        "category": "database",
        "compose": {
          "document": "services:\n  pgadmin:\n    image: dpage/pgadmin4:latest\n    environment:\n      PGADMIN_DEFAULT_EMAIL: ${ADMIN_EMAIL}\n      PGADMIN_DEFAULT_PASSWORD: ${ADMIN_PASSWORD}\n    volumes:\n      - sweep148-pgadmin:/var/lib/pgadmin\nvolumes:\n  sweep148-pgadmin: {}\n",
          "profiles": [],
          "services": [
            "pgadmin"
          ],
          "primaryService": "pgadmin"
        },
        "variables": [
          {
            "key": "ADMIN_EMAIL",
            "label": "Admin email",
            "required": true,
            "valueKind": "string",
            "secret": false,
            "default": "admin@example.com",
            "sites": [
              {
                "service": "pgadmin",
                "path": [
                  "environment",
                  "PGADMIN_DEFAULT_EMAIL"
                ]
              }
            ]
          },
          {
            "key": "ADMIN_PASSWORD",
            "label": "Admin password",
            "required": true,
            "valueKind": "string",
            "secret": true,
            "sites": [
              {
                "service": "pgadmin",
                "path": [
                  "environment",
                  "PGADMIN_DEFAULT_PASSWORD"
                ]
              }
            ]
          }
        ],
        "generatedSecrets": [
          {
            "key": "ADMIN_PASSWORD",
            "purpose": "admin password",
            "label": "Admin password",
            "profile": {
              "kind": "base64url-32-bytes"
            }
          }
        ],
        "domains": [],
        "volumes": [
          {
            "id": "sweep148-pgadmin",
            "service": "pgadmin",
            "target": "/var/lib/pgadmin",
            "persistent": true,
            "backup": false
          }
        ],
        "loginFields": {
          "username": "ADMIN_EMAIL",
          "password": "ADMIN_PASSWORD"
        },
        "firstRunSetup": true
      }
    }
  ]
}
