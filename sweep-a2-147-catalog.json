{
  "schemaVersion": 1,
  "apps": [
    {
      "itemId": "sweep-a2-147",
      "app": {
        "schemaVersion": 1,
        "title": "Sweep A2 Catalog App",
        "description": "Controlled QA catalog version 2",
        "category": "utilities",
        "compose": {
          "document": "services:\n  web:\n    image: nginx:alpine\n    labels:\n      sweep.catalog-version: v2\n    environment:\n      PUBLIC_LABEL: ${PUBLIC_LABEL}\n    volumes:\n      - sweepdata:/data\nvolumes:\n  sweepdata: {}\n",
          "profiles": [],
          "services": [
            "web"
          ],
          "primaryService": "web"
        },
        "variables": [
          {
            "key": "PUBLIC_LABEL",
            "label": "Public label",
            "required": true,
            "valueKind": "string",
            "secret": false,
            "default": "catalog-v2",
            "sites": [
              {
                "service": "web",
                "path": [
                  "environment",
                  "PUBLIC_LABEL"
                ]
              }
            ]
          }
        ],
        "generatedSecrets": [],
        "domains": [],
        "volumes": [
          {
            "id": "sweepdata",
            "service": "web",
            "target": "/data",
            "persistent": true,
            "backup": false
          }
        ]
      }
    }
  ]
}
